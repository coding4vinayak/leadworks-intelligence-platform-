# Leadworks Intelligence Platform - Environment Variables
# Copy this to .env and fill in your values

# App
SECRET_KEY=your-secret-key-here
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://leadworks:leadworks@localhost:5432/leadworks
DATABASE_SYNC_URL=postgresql://leadworks:leadworks@localhost:5432/leadworks

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
JWT_SECRET=your-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI (for AI enrichment, scoring, outreach generation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# HubSpot
HUBSPOT_API_KEY=your-hubspot-key

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Scraping
SCRAPER_MAX_CONCURRENT=5
SCRAPER_TIMEOUT=30
